@page "/"
@rendermode InteractiveServer
@using CrossWords.Components.Test

<PageTitle>Crosswords</PageTitle>

<h1>Crosswords</h1>

<input id="word" @bind="word" @onkeyup="HandleKeyPress" />

<button @onclick="AddWordToList">Add word</button>

<p>@string.Join(", ", wordList)</p>

<button @onclick="ClearList">Clear List</button>

@code {
    private string word = "";
    private List<string> wordList = new List<string>();
    private void AddWordToList()
    {
        @* Console.WriteLine($"{word}");
        foreach  (var w in wordList)
        {
            Console.WriteLine($"{w}");
        } *@
        @* var test = new Test();
        test.TestPath();
        test.GetIntersection(); *@

        if (!string.IsNullOrWhiteSpace(word))
        {
            wordList.Add(word);
            word = "";
            return;
        }
    }

    private void HandleKeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            AddWordToList();
        }
    }
    private void ClearList()
    {
        wordList.Clear();
    }
}